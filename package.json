{
  "name": "trade-count",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @trade-count/ledger -w @trade-count/local-store -w @trade-count/sync-crypto -w @trade-count/sync-server -w @trade-count/sync-client",
    "start": "npm start -w @trade-count/web",
    "build": "npm run build -w @trade-count/web",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint -w @trade-count/web",
    "deploy": "node scripts/check-operator.mjs && npm run build && wrangler pages deploy apps/web/dist/web/browser --project-name trade-count --branch main",
    "preview:prod": "npm run build && wrangler pages dev --port 8788 --binding RATE_LIMIT_SALT=local-dev-only-salt",
    "typecheck:functions": "tsc -p functions/tsconfig.json",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "check:operator": "node scripts/check-operator.mjs",
    "insights:lock": "node scripts/insights-lock.mjs",
    "screenshots": "SCREENSHOTS=1 playwright test --grep @screenshots --project=chromium"
  },
  "allowScripts": {
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true,
    "workerd@1.20261001.1": true,
    "esbuild@0.28.1": true
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "typescript": "6.0.3",
    "wrangler": "4.147.0"
  },
  "license": "AGPL-3.0-only"
}
