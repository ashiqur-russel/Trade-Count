{
  "name": "trade-count",
  "private": true,
  "engines": {
    "node": ">=22.12"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "npm run build -w @trade-count/ledger -w @trade-count/local-store",
    "start": "npm start -w @trade-count/web",
    "build": "npm run build -w @trade-count/web",
    "test": "npm test --workspaces --if-present",
    "lint": "npm run lint -w @trade-count/web"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "lmdb@3.5.6": true,
    "msgpackr-extract@3.0.4": true,
    "@parcel/watcher@2.6.0": true
  }
}
